# ==============================================================================
# RK Vibes Event Planner - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. In local development:
#    - APP_ENV=local, APP_DEBUG=true, DB_CONNECTION=sqlite, MAIL_MAILER=log
# 3. In production:
#    - Set APP_ENV=production
#    - Set APP_DEBUG=false
#    - Set APP_URL=https://your-production-domain.com
#    - Generate a secure key: php artisan key:generate
#    - Configure production database (e.g., MySQL) and mail credentials (SMTP)
#    - Set SESSION_SECURE_COOKIE=true (when serving over HTTPS)
#
# IMPORTANT: NEVER commit real credentials, API keys, or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_NAME="RK Vibes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Default development driver: sqlite
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
# DB_FOREIGN_KEYS=true

# Production MySQL/MariaDB Configuration (Uncomment and configure for production):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rkvibes_production
# DB_USERNAME=rkvibes_user
# DB_PASSWORD=your_strong_database_password_here
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production with HTTPS, set SESSION_SECURE_COOKIE to true:
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Cache, Queue, and Filesystem
# ------------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------------
# Mail Configuration
# ------------------------------------------------------------------------------
# In local development: use 'log' to log outgoing emails to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@rkvibes.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP Example (configure with your email provider such as Mailgun, Postmark, AWS SES, or SMTP):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=your_smtp_username_here
# MAIL_PASSWORD=your_smtp_password_here
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="notifications@yourdomain.com"
# MAIL_FROM_NAME="RK Vibes Events"

# Administrator Email (Receives booking confirmations & contact inquiries)
ADMIN_EMAIL="admin@rkvibes.com"

# Administrator Provisioning (Optional: Used by AdminUserSeeder if seeding in production)
# Alternatively, create admins interactively using: php artisan admin:create
# ADMIN_NAME="RK Vibes Administrator"
# ADMIN_PASSWORD=your_strong_admin_password_here

# ------------------------------------------------------------------------------
# Optional Services (Redis, AWS, Vite)
# ------------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Stripe Payments (Test Mode)
# ------------------------------------------------------------------------------
# Get your test mode keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=pk_test_placeholder
STRIPE_SECRET=sk_test_placeholder
# Webhook secret from Stripe CLI (`stripe listen`) or Stripe Dashboard Webhooks:
STRIPE_WEBHOOK_SECRET=whsec_placeholder
